{
  "name": "amazing-claude-code-relay",
  "version": "0.1.0",
  "description": "A tiny relay that introduces a JetBrains IDE running Amazing Claude Code to a paired phone, and passes sealed envelopes between them.",
  "private": false,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "node --experimental-strip-types src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "web-push": "^3.6.7",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.5.13",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10"
  }
}
