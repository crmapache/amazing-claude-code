{
  "name": "amazing-claude-code",
  "private": true,
  "license": "Elastic-2.0",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r --if-present typecheck",
    "build:webview": "pnpm --filter amazing-claude-code-webview build",
    "build:mobile": "pnpm --filter amazing-claude-code-webview build:mobile",
    "build:relay": "pnpm --filter amazing-claude-code-relay build",
    "build:feedback": "pnpm --filter amazing-claude-code-feedback build",
    "dev": "pnpm --filter amazing-claude-code-webview dev",
    "dev:relay": "pnpm --filter amazing-claude-code-relay dev",
    "dev:feedback": "pnpm --filter amazing-claude-code-feedback dev"
  }
}
