# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar

# Песочница тестовой IDE
.intellijPlatform/

# Служебные данные компилятора Kotlin
.kotlin/

# IDE
.idea/
*.iml

# Node / интерфейс
node_modules/
webview/dist/

# Собранная статика интерфейса попадает в ресурсы на этапе сборки
src/main/resources/webview/

# macOS
.DS_Store

# Служебные снимки страниц и консольные логи от Playwright MCP — отладочный
# мусор, не имеет отношения к исходникам проекта.
.playwright-mcp/

# Секреты публикации на маркетплейс — токен и сертификат подписи плагина,
# в репозитории им не место ни в каком виде.
.env
secrets/

# Личное в настройках Claude Code: разрешения этой машины и замок планировщика.
# Сами скиллы проекта (.claude/skills/) отслеживаются - они общие.
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Рабочие заметки и планы в корне: черновики для себя, не часть проекта.
REMOTE-ACCESS-PLAN.md
/REPLAY-STREAMING.md
# Аудит безопасности удалённого доступа: живой документ с ещё не закрытыми дырами - где они в коде
# и как ими воспользоваться. Репозиторий публичный, так что один `git add -A` превратил бы его в
# опубликованную инструкцию по уже выпущенным сборкам. Лежит в корне и остаётся на виду, но попасть
# в коммит не может.
/SECURITY-REMOTE-CONTROL.md
# Выгрузки ревью (`/code-review`, `/pr-review`) - рабочий список на один разговор.
/REVIEW-*.md
# The phone client is built separately and served by the relay rather than shipped in the plugin.
webview/dist-mobile

# The same bundle, staged where the relay serves it from. Deliberately ignored here rather than in
# relay/.gitignore: the deploy uploads that directory, and an ignore rule inside it would keep the
# client out of the image as well as out of the repository (see relay/.railwayignore).
relay/public/*
!relay/public/.gitkeep

# Скриншоты панели, которые делаются в корне при проверке интерфейса: они для одного разговора,
# в репозитории им не место.
/*.png
