{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src"],
  // The tests are not part of what ships: compiled into dist they would be copied into the image, and
  // vitest would then find both the source and the build of every one of them and run each twice.
  "exclude": ["src/**/*.test.ts"]
}
