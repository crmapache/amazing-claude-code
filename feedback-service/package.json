  "description": "A tiny service that takes a piece of feedback from the plugin's panel and hands it to the author's Telegram.",
  "private": true,
  "license": "Elastic-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
